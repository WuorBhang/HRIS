rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Users collection
    match /users/{uid} {
      // Anyone signed in can read their own doc; admin can read all.
      allow read: if isSelf(uid) || isAdmin();

      // Only admin can create new user profiles.
      // Self-creation is allowed only when bootstrapping the admin profile
      // (matches AuthContext bootstrap flow).
      allow create: if isAdmin() || isSelf(uid);

      // Self can update only their avatar (photoURL) plus the housekeeping
      // fields needed by the first-login flow (mustChangePassword,
      // updatedAt) and the approved -> active status transition.
      // All other personal-detail fields (fullName, phone, address, bio,
      // dateOfBirth, nationalId, emergencyContact, role, email, etc.) are
      // editable by admin only.
      // Employer-specific commercial fields (tier, subscriptionStatus) are
      // also strictly admin-only — explicitly excluded from the affected
      // keys list below.
      allow update: if isAdmin()
        || (
          isSelf(uid)
          && request.resource.data.role == resource.data.role
          && (
            request.resource.data.status == resource.data.status
            || (resource.data.status == 'approved' && request.resource.data.status == 'active')
          )
          && !('tempPassword' in request.resource.data.diff(resource.data).affectedKeys())
          && !('tier' in request.resource.data.diff(resource.data).affectedKeys())
          && !('subscriptionStatus' in request.resource.data.diff(resource.data).affectedKeys())
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['photoURL', 'updatedAt', 'mustChangePassword', 'status', 'lastLoginAt', 'lastSeenAt', 'sessionStartAt'])
        );

      // Only admin can delete users.
      allow delete: if isAdmin();
    }

    // Contracts collection
    match /contracts/{contractId} {
      allow read: if isAdmin()
        || (isSignedIn() && request.auth.uid == resource.data.employerId)
        || (isSignedIn() && request.auth.uid == resource.data.employeeId);

      allow create, update, delete: if isAdmin();
    }

    // Public holidays — readable by any signed-in user.
    // Seeded Kenya holidays (id prefix `ke-`) are auto-synced from
    // src/lib/holidaySeed.js on every login, so any signed-in user is
    // allowed to create / update / delete those specific docs. Holidays
    // added manually (any other id) remain admin-only.
    match /public_holidays/{holidayId} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        || (isSignedIn() && holidayId.matches('^ke-.*'));
      allow update, delete: if isAdmin()
        || (isSignedIn() && holidayId.matches('^ke-.*'));
    }

    // Overtime / holiday work records
    match /overtime_clock_records/{recordId} {
      allow read: if isAdmin()
        || (isSignedIn() && request.auth.uid == resource.data.employeeId)
        || (isSignedIn() && request.auth.uid == resource.data.employerId);

      // Employee can create a record for themselves
      allow create: if isSignedIn()
        && request.resource.data.employeeId == request.auth.uid
        && request.resource.data.status == 'pending';

      // Admin or the linked employer can update status (approve/reject)
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == resource.data.employerId);

      allow delete: if isAdmin();
    }

    // Activity logs — append-only audit trail.
    // Any signed-in user can record an entry about their own action.
    // Users can read their own log entries (where performedBy == their uid).
    // Admin can read all logs and delete them. No one can update (logs are immutable).
    match /activity_logs/{logId} {
      allow create: if isSignedIn()
        && request.resource.data.performedBy == request.auth.uid;
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.performedBy == request.auth.uid);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Documents (contracts, payslips, statutory filings, IDs, policies, etc.)
    // Uploaded by admin and scoped to a contract (employerId + employeeId)
    // and/or a specific user via ownerId. Admin can read and manage all.
    //
    // Read access by document `type`:
    //   - 'payslip'   → employer AND employee on the linked contract
    //                   (also any explicit ownerId match).
    //   - 'statutory' → employer ONLY (statutory filings are confidential
    //                   to the employer; employee cannot read).
    //   - all other types (contract, id, policy, etc.) → owner (employee)
    //     and the linked employer.
    match /documents/{docId} {
      allow read: if isAdmin()
        || (
          isSignedIn()
          && resource.data.type == 'payslip'
          && (
            request.auth.uid == resource.data.employerId
            || request.auth.uid == resource.data.employeeId
            || request.auth.uid == resource.data.ownerId
          )
        )
        || (
          isSignedIn()
          && resource.data.type == 'statutory'
          && request.auth.uid == resource.data.employerId
        )
        || (
          isSignedIn()
          && resource.data.type != 'payslip'
          && resource.data.type != 'statutory'
          && (
            request.auth.uid == resource.data.ownerId
            || request.auth.uid == resource.data.employerId
          )
        );
      allow create, update, delete: if isAdmin();
    }

    // App-level counters (e.g. contract numbering). Admin-only writes.
    match /counters/{counterId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Monthly records (payslips, statutory filings, payroll summaries).
    // Each record is scoped to a contract and a single month (YYYY-MM).
    // Employer (the linked employer on the contract) writes; both parties
    // (employer + employee) read. Admin can read and manage everything.
    match /monthly_records/{recordId} {
      allow read: if isAdmin()
        || (isSignedIn() && request.auth.uid == resource.data.employerId)
        || (isSignedIn() && request.auth.uid == resource.data.employeeId);

      allow create: if isAdmin()
        || (
          isSignedIn()
          && request.resource.data.employerId == request.auth.uid
          && request.resource.data.contractId is string
          && request.resource.data.month is string
        );

      allow update: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == resource.data.employerId
          && request.resource.data.employerId == resource.data.employerId
          && request.resource.data.employeeId == resource.data.employeeId
          && request.resource.data.contractId == resource.data.contractId
          && request.resource.data.month == resource.data.month
        );

      allow delete: if isAdmin();
    }

    // Leave requests
    match /leave_requests/{requestId} {
      allow read: if isAdmin()
        || (isSignedIn() && request.auth.uid == resource.data.employeeId)
        || (isSignedIn() && request.auth.uid == resource.data.employerId);

      // Employee can create a request for themselves
      allow create: if isSignedIn()
        && request.resource.data.employeeId == request.auth.uid
        && request.resource.data.status == 'pending';

      // Admin or the linked employer can approve / reject
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == resource.data.employerId);

      allow delete: if isAdmin();
    }
  }
}
